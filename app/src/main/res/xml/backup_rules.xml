<full-backup-content>
    <!-- Strictly forbid Android cloud / ADB backup of all local E2EE keys, databases, vaults, and shared prefs -->
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>